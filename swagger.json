{
  "openapi": "3.0.0",
  "info": {
    "title": "Nogosari Backend API",
    "version": "1.0.0",
    "description": "API Documentation untuk Sistem Website Desa Nogosari & Monitoring IoT"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Login Admin",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil, return token"
          },
          "401": {
            "description": "Email atau password salah"
          }
        }
      }
    },
    "/api/sensor/latest": {
      "get": {
        "summary": "Mendapatkan pembacaan ketinggian air terbaru",
        "tags": [
          "Sensor IoT"
        ],
        "responses": {
          "200": {
            "description": "Data terbaru sensor"
          }
        }
      }
    },
    "/api/sensor/history": {
      "get": {
        "summary": "Mendapatkan riwayat pembacaan ketinggian air",
        "tags": [
          "Sensor IoT"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "Jumlah data yang diambil"
          }
        ],
        "responses": {
          "200": {
            "description": "List data riwayat sensor"
          }
        }
      }
    },
    "/api/sensor/devices": {
      "get": {
        "summary": "Mendapatkan daftar perangkat sensor dan threshold",
        "tags": [
          "Sensor IoT"
        ],
        "responses": {
          "200": {
            "description": "List perangkat sensor"
          }
        }
      }
    },
    "/api/sensor/devices/{id_sensor}/threshold": {
      "put": {
        "summary": "Mengubah nilai threshold perangkat sensor (Admin)",
        "tags": [
          "Sensor IoT"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id_sensor",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID Sensor (contoh: SN-001)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "threshold_waspada": {
                    "type": "number"
                  },
                  "threshold_siaga": {
                    "type": "number"
                  },
                  "threshold_bahaya": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Threshold berhasil diubah"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/rentan-banjir": {
      "get": {
        "summary": "Mendapatkan semua data kelompok rentan banjir",
        "tags": [
          "Kelompok Rentan"
        ],
        "responses": {
          "200": {
            "description": "List data kelompok rentan"
          }
        }
      },
      "post": {
        "summary": "Menambahkan data kelompok rentan (Admin)",
        "tags": [
          "Kelompok Rentan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kategori_usia": {
                    "type": "string"
                  },
                  "jumlah_jiwa": {
                    "type": "integer"
                  },
                  "keterangan": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Data berhasil ditambahkan"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/rentan-banjir/{id}": {
      "put": {
        "summary": "Mengupdate data kelompok rentan (Admin)",
        "tags": [
          "Kelompok Rentan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kategori_usia": {
                    "type": "string"
                  },
                  "jumlah_jiwa": {
                    "type": "integer"
                  },
                  "keterangan": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data berhasil diupdate"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "delete": {
        "summary": "Menghapus data kelompok rentan (Admin)",
        "tags": [
          "Kelompok Rentan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data berhasil dihapus"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/pengaduan": {
      "post": {
        "summary": "Mengirim pengaduan baru (Publik/Warga)",
        "tags": [
          "Pengaduan"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nama_pengirim": {
                    "type": "string"
                  },
                  "kontak": {
                    "type": "string"
                  },
                  "isi_pengaduan": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pengaduan berhasil dikirim"
          }
        }
      },
      "get": {
        "summary": "Melihat semua pengaduan (Admin)",
        "tags": [
          "Pengaduan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List pengaduan"
          }
        }
      }
    },
    "/api/pengaduan/{id}": {
      "delete": {
        "summary": "Menghapus pengaduan (Admin)",
        "tags": [
          "Pengaduan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pengaduan berhasil dihapus"
          }
        }
      }
    }
  }
}